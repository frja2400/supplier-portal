@model List<SupplierPortal.Models.ImportedActivationRow>

@{
    ViewData["Title"] = "Import preview";
    var validCount = Model.Count(r => r.IsValid);
    var invalidCount = Model.Count(r => !r.IsValid);
    var newSupplierCount = Model.Where(r => r.IsValid).Select(r => r.SupplierName.ToLower()).Distinct()
        .Count(name => !Model.First(r => r.SupplierName.ToLower() == name).SupplierExists);
}

<h1 class="mb-3">Import preview</h1>

<div class="mb-4">
    <p>
        <strong>@validCount</strong> row(s) will be imported.
        @if (invalidCount > 0)
        {
            <span class="text-danger"><strong>@invalidCount</strong> row(s) have errors and will be skipped.</span>
        }
    </p>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Row</th>
            <th>Supplier</th>
            <th>Product</th>
            <th>Impressions</th>
            <th>Clicks</th>
            <th>Revenue</th>
            <th>Period</th>
            <th>Year</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model)
        {
            <tr class="@(row.IsValid ? "" : "table-danger")">
                <td>@row.RowNumber</td>
                <td>
                    @row.SupplierName
                    @if (row.IsValid && !row.SupplierExists)
                    {
                        <span class="badge" style="background-color: var(--bs-primary);">New supplier</span>
                    }
                </td>
                <td>@row.Product</td>
                <td>@row.ImpressionsRaw</td>
                <td>@row.ClicksRaw</td>
                <td>@row.RevenueRaw</td>
                <td>@row.Period</td>
                <td>@row.YearRaw</td>
                <td>
                    @if (row.IsValid)
                    {
                        <span class="text-success">OK</span>
                    }
                    else
                    {
                        <span class="text-danger">@string.Join("; ", row.Errors)</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (validCount > 0)
{
    <form asp-controller="Import" asp-action="Confirm" method="post">
        @for (int i = 0; i < Model.Count; i++)
        {
            var row = Model[i];
            if (!row.IsValid) continue;

            <input type="hidden" asp-for="@row.RowNumber" name="rows[@i].RowNumber" />
            <input type="hidden" asp-for="@row.SupplierName" name="rows[@i].SupplierName" />
            <input type="hidden" asp-for="@row.Product" name="rows[@i].Product" />
            <input type="hidden" asp-for="@row.ImpressionsRaw" name="rows[@i].ImpressionsRaw" />
            <input type="hidden" asp-for="@row.ClicksRaw" name="rows[@i].ClicksRaw" />
            <input type="hidden" asp-for="@row.RevenueRaw" name="rows[@i].RevenueRaw" />
            <input type="hidden" asp-for="@row.Period" name="rows[@i].Period" />
            <input type="hidden" asp-for="@row.YearRaw" name="rows[@i].YearRaw" />
            <input type="hidden" name="rows[@i].IsValid" value="true" />
        }

        <button type="submit" class="btn btn-primary">Confirm import (@validCount rows)</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
}
else
{
    <p class="text-muted">No valid rows to import.</p>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
}