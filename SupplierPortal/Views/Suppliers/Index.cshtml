@model SupplierPortal.Models.ViewModels.SuppliersIndexViewModel

@{
    ViewData["Title"] = "Suppliers";
}

<h1 class="mb-3">Suppliers</h1>

<p>
    <a asp-controller="Suppliers" asp-action="Create" class="btn btn-primary">+ Add supplier</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Account email</th>
            <th>Account manager</th>
            <th>Looker Studio</th>
            <th><span class="visually-hidden">Actions</span></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Suppliers)
        {
            <tr>
                <td>@item.Name</td>
                <td>
                    @(Model.AccountEmailBySupplierId.TryGetValue(item.Id, out var email) ? email : "—")
                </td>
                <td>@(item.AccountManager?.Email ?? "—")</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.LookerStudioUrl))
                    {
                        <a href="@item.LookerStudioUrl" target="_blank">Link</a>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Suppliers.Any())
{
    <p><em>No suppliers registered yet.</em></p>
}

<hr class="my-4" />

<h2 class="mb-3">Create supplier account</h2>

<div class="row">
    <div class="col-md-4">
        <form asp-action="CreateAccount" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="NewAccount.SupplierId" class="form-label">Supplier</label>
                <select asp-for="NewAccount.SupplierId" class="form-select"
                        asp-items="ViewBag.AvailableSuppliersForAccount">
                    <option value="">-- Select supplier --</option>
                </select>
                <span asp-validation-for="NewAccount.SupplierId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewAccount.Email" class="form-label">Account email</label>
                <input asp-for="NewAccount.Email" class="form-control" />
                <span asp-validation-for="NewAccount.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewAccount.Password" class="form-label">Temporary password</label>
                <div class="input-group">
                    <input asp-for="NewAccount.Password" class="form-control" type="text" />
                    <button type="button" class="btn btn-outline-secondary"
                            onclick="generatePassword()">Generate</button>
                </div>
                <span asp-validation-for="NewAccount.Password" class="text-danger"></span>
            </div>

            <div class="alert alert-info">
                Copy the generated password before submitting, it cannot be retrieved afterwards.
            </div>

            <button type="submit" class="btn btn-primary">Create account</button>
        </form>
    </div>
</div>

<script>
    function generatePassword() {
        const upper = "ABCDEFGHJKLMNPQRSTUVWXYZ";
        const lower = "abcdefghijkmnopqrstuvwxyz";
        const digits = "23456789";
        const special = "!?#%&*";
        const all = upper + lower + digits + special;

        let password = [
            upper[Math.floor(Math.random() * upper.length)],
            lower[Math.floor(Math.random() * lower.length)],
            digits[Math.floor(Math.random() * digits.length)],
            special[Math.floor(Math.random() * special.length)]
        ];

        for (let i = password.length; i < 12; i++) {
            password.push(all[Math.floor(Math.random() * all.length)]);
        }

        password = password.sort(() => Math.random() - 0.5).join("");

        document.getElementById("NewAccount_Password").value = password;
    }
</script>