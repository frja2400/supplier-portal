@model IEnumerable<SupplierPortal.Models.Supplier>

@{
    ViewData["Title"] = "Suppliers";
}

<h1>Suppliers</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Add supplier</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Account manager</th>
            <th>Looker Studio</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@(item.AccountManager?.Email ?? "—")</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.LookerStudioUrl))
                    {
                        <a href="@item.LookerStudioUrl" target="_blank">Link</a>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p><em>No suppliers registered yet.</em></p>
}