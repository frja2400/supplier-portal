@model SupplierPortal.Models.Supplier

@{
    ViewData["Title"] = "Delete supplier";
}

<h1>Delete supplier</h1>

<div class="alert alert-warning">
    <strong>Warning:</strong> Deleting this supplier will also permanently delete
    all of its registered activations. This cannot be undone.
</div>

<p>Are you sure you want to delete this supplier?</p>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Account manager</dt>
    <dd class="col-sm-9">@(Model.AccountManager?.Email ?? "—")</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>