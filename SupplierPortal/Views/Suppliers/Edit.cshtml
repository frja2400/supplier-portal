@model SupplierPortal.Models.Supplier

@{
    ViewData["Title"] = "Edit supplier";
}

<h1>Edit supplier</h1>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LookerStudioUrl" class="form-label">Looker Studio URL (optional)</label>
                <input asp-for="LookerStudioUrl" class="form-control" type="text"
                       placeholder="https://lookerstudio.google.com/..." />
                <span asp-validation-for="LookerStudioUrl" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AccountManagerId" class="form-label">Account manager (optional)</label>
                <select asp-for="AccountManagerId" class="form-select" asp-items="ViewBag.AccountManagerId">
                    <option value="">-- Not assigned --</option>
                </select>
                <span asp-validation-for="AccountManagerId" class="text-danger"></span>
            </div>

            @if (ViewBag.AccountEmail != null)
            {
                <div class="mb-3">
                    <label class="form-label">Account email</label>
                    <input type="email" name="accountEmail" class="form-control" value="@ViewBag.AccountEmail" />
                    <span class="text-danger">
                        @Html.ValidationMessage("accountEmail")
                    </span>
                </div>
            }
            else
            {
                <p class="text-muted"><em>This supplier does not have an account yet. Create one from the Suppliers
                    list.</em></p>
                }

                <button type="submit" class="btn btn-primary">Save changes</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>

            @if (ViewBag.AccountEmail != null)
            {
                <form asp-action="RemoveAccount" method="post" class="mt-2"
                      onsubmit="return confirm('Remove this supplier\'s account? They will no longer be able to log in.');">
                    <input type="hidden" name="supplierId" value="@Model.Id" />
                    <button type="submit" class="btn btn-outline-danger btn-sm">Remove account</button>
                </form>
            }
        </div>
    </div>