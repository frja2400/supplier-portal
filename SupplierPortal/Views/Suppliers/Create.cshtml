@model SupplierPortal.Models.Supplier

@{
    ViewData["Title"] = "Add supplier";
}

<h1>Add supplier</h1>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LookerStudioUrl" class="form-label">Looker Studio URL (optional)</label>
                <input asp-for="LookerStudioUrl" class="form-control" type="text"
                       placeholder="https://lookerstudio.google.com/..." />
                <span asp-validation-for="LookerStudioUrl" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AccountManagerId" class="form-label">Account manager (optional)</label>
                <select asp-for="AccountManagerId" class="form-select" asp-items="ViewBag.AccountManagerId">
                    <option value="">-- Not assigned --</option>
                </select>
                <span asp-validation-for="AccountManagerId" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save supplier</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>