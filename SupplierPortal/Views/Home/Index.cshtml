@model SupplierPortal.Models.ViewModels.HomeStatsViewModel

@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">MEDS Supplier Portal</h1>
    <p class="lead">
        Track and share marketing activation results with suppliers.
    </p>
</div>

<div class="row justify-content-center mt-5">
    <div class="col-md-3">
        <div class="card text-center p-4">
            <h2 class="display-5">@Model.ActivationCount</h2>
            <p class="text-muted mb-0">Registered activations</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center p-4">
            <h2 class="display-5">@Model.SupplierCount</h2>
            <p class="text-muted mb-0">Suppliers</p>
        </div>
    </div>
</div>