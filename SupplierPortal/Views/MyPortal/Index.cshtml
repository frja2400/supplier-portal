@model IEnumerable<SupplierPortal.Models.Activation>
@{
    ViewData["Title"] = "My Activations";
    var supplier = (SupplierPortal.Models.Supplier)ViewBag.Supplier;
    var selectedPeriods = (List<string>)ViewBag.SelectedPeriods;
}

@functions {
    string NextSort(string column, string currentSort)
    {
        return currentSort == $"{column}_asc" ? $"{column}_desc" : $"{column}_asc";
    }
}

<h1>@supplier.Name</h1>

<div class="mb-4">
    @if (supplier.AccountManager != null)
    {
        <p>
            <strong>Your contact person:</strong>
            @supplier.AccountManager.Email
        </p>
    }
    else
    {
        <p class="text-muted"><em>No account manager assigned yet.</em></p>
    }

    @if (!string.IsNullOrEmpty(supplier.LookerStudioUrl))
    {
        <a href="@supplier.LookerStudioUrl" target="_blank" class="btn btn-outline-primary btn-sm">
            View Looker Studio report
        </a>
    }
</div>

<h2>Your activations</h2>

<form asp-action="Index" method="get" id="filterForm" class="row g-2 mb-2">
    <div class="col-auto">
        <select id="periodSelect" class="form-select" asp-items="ViewBag.PeriodFilter">
            <option value="">-- All periods --</option>
        </select>
    </div>

    @foreach (var p in selectedPeriods)
    {
        <input type="hidden" name="period" value="@p" />
    }
    <input type="hidden" name="sortOrder" value="@ViewBag.CurrentSort" />
</form>

@if (selectedPeriods.Any())
{
    <div class="mb-3">
        @foreach (var p in selectedPeriods)
        {
            <a class="btn btn-sm btn-outline-secondary me-1" href="@Url.Action("Index", new
               {
                   period = selectedPeriods.Where(x => x != p).ToArray(),
                   sortOrder = ViewBag.CurrentSort
               })">
                Period: @p &times;
            </a>
        }
        <a class="btn btn-sm btn-link" asp-action="Index">Clear all</a>
    </div>
}

<table class="table">
    <thead>
        <tr>
            <th>
                <a
                href="@Url.Action("Index", new { sortOrder = NextSort("product", ViewBag.CurrentSort), period = selectedPeriods.ToArray() })">Product</a>
            </th>
            <th>
                <a
                href="@Url.Action("Index", new { sortOrder = NextSort("impressions", ViewBag.CurrentSort), period = selectedPeriods.ToArray() })">Impressions</a>
            </th>
            <th>
                <a
                href="@Url.Action("Index", new { sortOrder = NextSort("clicks", ViewBag.CurrentSort), period = selectedPeriods.ToArray() })">Clicks</a>
            </th>
            <th>
                <a
                href="@Url.Action("Index", new { sortOrder = NextSort("revenue", ViewBag.CurrentSort), period = selectedPeriods.ToArray() })">Revenue</a>
            </th>
            <th>
                <a
                href="@Url.Action("Index", new { sortOrder = NextSort("period", ViewBag.CurrentSort), period = selectedPeriods.ToArray() })">Period</a>
            </th>
            <th>
                <a
                href="@Url.Action("Index", new { sortOrder = NextSort("year", ViewBag.CurrentSort), period = selectedPeriods.ToArray() })">Year</a>
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Product</td>
                <td>@item.Impressions</td>
                <td>@item.Clicks</td>
                <td>@item.Revenue.ToString("N0") SEK</td>
                <td>@item.Period</td>
                <td>@item.Year</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p><em>No activations registered yet.</em></p>
}

<script>
    document.getElementById('periodSelect').addEventListener('change', function () {
        if (!this.value) return;

        const url = new URL(window.location);
        url.searchParams.append('period', this.value);
        window.location = url;
    });
</script>