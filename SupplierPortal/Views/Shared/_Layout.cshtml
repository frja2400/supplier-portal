<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Supplier Portal</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SupplierPortal.styles.css" asp-append-version="true" />
</head>

<body>
    <div class="d-flex" style="min-height: 100vh;">
        <nav class="d-flex flex-column flex-shrink-0 p-3"
             style="width: 240px; background-color: var(--sidebar-bg); border-right: 1px solid var(--sidebar-border);">
            <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center mb-3 text-decoration-none">
                <span class="fs-5 fw-bold" style="color: var(--bs-primary);">Supplier Portal</span>
            </a>
            <hr />

            @if (User.IsInRole(SupplierPortal.Data.SeedData.MedsEmployeeRole))
            {
                <ul class="nav nav-pills flex-column mb-auto">
                    <li class="nav-item">
                        <a asp-controller="Activations" asp-action="Index"
                           class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Activations" ? "active" : "text-dark")"
                           style="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Activations" ? $"background-color: var(--sidebar-active-bg); color: var(--bs-primary);" : "")">
                            Activations
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Suppliers" asp-action="Index"
                           class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Suppliers" ? "active" : "text-dark")"
                           style="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Suppliers" ? $"background-color: var(--sidebar-active-bg); color: var(--bs-primary);" : "")">
                            Suppliers
                        </a>
                    </li>
                </ul>
            }
            else if (User.IsInRole(SupplierPortal.Data.SeedData.SupplierRole))
            {
                <ul class="nav nav-pills flex-column mb-auto">
                    <li class="nav-item">
                        <a asp-controller="MyPortal" asp-action="Index"
                           class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "MyPortal" ? "active" : "text-dark")"
                           style="@(ViewContext.RouteData.Values["controller"]?.ToString() == "MyPortal" ? $"background-color: var(--sidebar-active-bg); color: var(--bs-primary);" : "")">
                            My Activations
                        </a>
                    </li>
                </ul>
            }
            else
            {
                <div class="mb-auto"></div>
            }

            <hr />

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="mb-2">
                    <small class="text-muted d-block">Logged in as</small>
                    <small class="fw-semibold" style="word-break: break-all;">@User.Identity.Name</small>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-outline-secondary btn-sm w-100">
                        Log out
                    </button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm w-100">
                    Log in
                </a>
            }
        </nav>

        <main class="flex-grow-1 p-4">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
