@model SupplierPortal.Models.Activation

@{
    ViewData["Title"] = "Delete activation";
}

<h1>Delete activation</h1>

<p>Are you sure you want to delete this activation?</p>

<dl class="row">
    <dt class="col-sm-2">Supplier</dt>
    <dd class="col-sm-10">@Model.Supplier.Name</dd>

    <dt class="col-sm-2">Product</dt>
    <dd class="col-sm-10">@Model.Product</dd>

    <dt class="col-sm-2">Period</dt>
    <dd class="col-sm-10">@Model.Period @Model.Year</dd>

    <dt class="col-sm-2">Revenue</dt>
    <dd class="col-sm-10">@Model.Revenue.ToString("N0") SEK</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>